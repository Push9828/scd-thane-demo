# Copy to .env and replace these values. Keep .env private.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4.1-mini"

# Values from the deployed SAM stack and an attendee access token.
CONFERENCE_API_URL="https://your-api-id.execute-api.your-region.amazonaws.com"
CONFERENCE_ACCESS_TOKEN="your-attendee-access-token"
TABLE_NAME="your-stack-table-name"
AWS_REGION="your-aws-region"

# Supply these as JwtIssuer and JwtAudience during sam deploy --guided.
JWT_ISSUER="https://your-oidc-issuer.example.com"
JWT_AUDIENCE="your-api-audience"

# For the optional local Cognito PKCE token helper.
COGNITO_DOMAIN="https://your-domain.auth.your-region.amazoncognito.com"
COGNITO_CLIENT_ID="your-cognito-app-client-id"
